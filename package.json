{
  "name": "graftwork-design-system",
  "private": true,
  "description": "Graftwork design system monorepo",
  "license": "MIT",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "tokens:validate": "pnpm --filter @graftwork/tokens validate",
    "lint": "eslint . && stylelint \"**/*.css\"",
    "test:visual": "pnpm --filter @graftwork/docs test:visual"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.8",
    "globals": "17.14.0",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  },
  "type": "module"
}
