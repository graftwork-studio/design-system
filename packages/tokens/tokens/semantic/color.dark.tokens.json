{
  "color": {
    "surface": {
      "$type": "color",
      "$description": "Dark theme. surface tokens.",
      "default": {
        "$value": "{color.shadcn.dark-background}",
        "$description": "Page background.",
        "$extensions": {
          "studio.graftwork": {
            "role": "background"
          }
        }
      },
      "raised": {
        "$value": "{color.shadcn.dark-card}",
        "$description": "Cards and panels.",
        "$extensions": {
          "studio.graftwork": {
            "role": "background"
          }
        }
      },
      "subtle": {
        "$value": "{color.shadcn.dark-muted}",
        "$description": "Table headers, wells, zebra rows.",
        "$extensions": {
          "studio.graftwork": {
            "role": "background"
          }
        }
      },
      "overlay": {
        "$value": "{color.shadcn.dark-card}",
        "$description": "Popovers, menus and dialogs.",
        "$extensions": {
          "studio.graftwork": {
            "role": "background"
          }
        }
      }
    },
    "overlay": {
      "$type": "color",
      "$description": "Dark theme. overlay tokens.",
      "scrim": {
        "$value": "{color.neutral.1000}",
        "$description": "Behind modal dialogs and sheets. Use at reduced opacity, e.g. bg-overlay-scrim/60. Never text or a surface. Black in the dark theme: the page is already near-black, so a scrim in the page's own colour wouldn't dim it.",
        "$extensions": {
          "studio.graftwork": {
            "role": "decorative"
          }
        }
      }
    },
    "action": {
      "$type": "color",
      "$description": "Dark theme. action tokens.",
      "primary": {
        "bg": {
          "$value": "{color.shadcn.dark-primary}",
          "$description": "Filled primary button.",
          "$extensions": {
            "studio.graftwork": {
              "role": "background"
            }
          }
        },
        "bg-hover": {
          "$value": "{color.shadcn.dark-primary-hover}",
          "$extensions": {
            "studio.graftwork": {
              "role": "background"
            }
          }
        }
      },
      "secondary": {
        "bg": {
          "$value": "{color.shadcn.dark-secondary}",
          "$description": "Secondary button.",
          "$extensions": {
            "studio.graftwork": {
              "role": "background"
            }
          }
        },
        "bg-hover": {
          "$value": "{color.shadcn.dark-secondary-hover}",
          "$extensions": {
            "studio.graftwork": {
              "role": "background"
            }
          }
        }
      },
      "ghost": {
        "bg-hover": {
          "$value": "{color.shadcn.dark-muted}",
          "$description": "Ghost button hover.",
          "$extensions": {
            "studio.graftwork": {
              "role": "background"
            }
          }
        }
      },
      "destructive": {
        "bg": {
          "$value": "{color.shadcn.dark-destructive}",
          "$description": "Filled destructive button.",
          "$extensions": {
            "studio.graftwork": {
              "role": "background"
            }
          }
        },
        "bg-hover": {
          "$value": "{color.shadcn.dark-destructive-hover}",
          "$extensions": {
            "studio.graftwork": {
              "role": "background"
            }
          }
        }
      }
    },
    "status": {
      "$type": "color",
      "$description": "Dark theme. status tokens.",
      "success": {
        "bg": {
          "$value": "{color.green.950}",
          "$extensions": {
            "studio.graftwork": {
              "role": "background"
            }
          }
        }
      },
      "warning": {
        "bg": {
          "$value": "{color.amber.950}",
          "$extensions": {
            "studio.graftwork": {
              "role": "background"
            }
          }
        }
      },
      "error": {
        "bg": {
          "$value": "{color.red.950}",
          "$extensions": {
            "studio.graftwork": {
              "role": "background"
            }
          }
        }
      },
      "info": {
        "bg": {
          "$value": "{color.shadcn.dark-muted}",
          "$extensions": {
            "studio.graftwork": {
              "role": "background"
            }
          }
        }
      }
    },
    "text": {
      "$type": "color",
      "$description": "Dark theme. text tokens.",
      "default": {
        "$value": "{color.shadcn.dark-foreground}",
        "$description": "Body and heading text.",
        "$extensions": {
          "studio.graftwork": {
            "role": "text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.subtle}",
              "{color.surface.overlay}",
              "{color.action.secondary.bg}",
              "{color.action.secondary.bg-hover}",
              "{color.action.ghost.bg-hover}",
              "{color.status.success.bg}",
              "{color.status.warning.bg}",
              "{color.status.error.bg}",
              "{color.status.info.bg}"
            ]
          }
        }
      },
      "secondary": {
        "$value": "{color.shadcn.dark-muted-foreground}",
        "$description": "Supporting text. At least 4.5:1 on its surfaces.",
        "$extensions": {
          "studio.graftwork": {
            "role": "text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.subtle}",
              "{color.surface.overlay}"
            ]
          }
        }
      },
      "placeholder": {
        "$value": "{color.shadcn.dark-muted-foreground}",
        "$description": "Input placeholders. At least 4.5:1; never the only label.",
        "$extensions": {
          "studio.graftwork": {
            "role": "text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.overlay}"
            ]
          }
        }
      },
      "link": {
        "$value": "{color.shadcn.dark-foreground}",
        "$description": "Links. Always underlined as well.",
        "$extensions": {
          "studio.graftwork": {
            "role": "text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.subtle}",
              "{color.surface.overlay}"
            ]
          }
        }
      },
      "on-primary": {
        "$value": "{color.shadcn.dark-primary-foreground}",
        "$description": "Labels on filled primary buttons.",
        "$extensions": {
          "studio.graftwork": {
            "role": "text",
            "on": [
              "{color.action.primary.bg}",
              "{color.action.primary.bg-hover}"
            ]
          }
        }
      },
      "on-destructive": {
        "$value": "{color.shadcn.dark-background}",
        "$description": "Labels on filled destructive buttons.",
        "$extensions": {
          "studio.graftwork": {
            "role": "text",
            "on": [
              "{color.action.destructive.bg}",
              "{color.action.destructive.bg-hover}"
            ]
          }
        }
      },
      "success": {
        "$value": "{color.green.300}",
        "$extensions": {
          "studio.graftwork": {
            "role": "text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.subtle}",
              "{color.status.success.bg}"
            ]
          }
        }
      },
      "warning": {
        "$value": "{color.amber.300}",
        "$extensions": {
          "studio.graftwork": {
            "role": "text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.subtle}",
              "{color.status.warning.bg}"
            ]
          }
        }
      },
      "error": {
        "$value": "{color.shadcn.dark-destructive}",
        "$description": "Error messages, linked to their field.",
        "$extensions": {
          "studio.graftwork": {
            "role": "text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.subtle}",
              "{color.status.error.bg}"
            ]
          }
        }
      },
      "info": {
        "$value": "{color.shadcn.dark-foreground}",
        "$extensions": {
          "studio.graftwork": {
            "role": "text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.subtle}",
              "{color.status.info.bg}"
            ]
          }
        }
      }
    },
    "border": {
      "$type": "color",
      "$description": "Dark theme. border tokens.",
      "input": {
        "$value": "{color.shadcn.dark-input-aa}",
        "$description": "Input, select and checkbox borders.",
        "$extensions": {
          "studio.graftwork": {
            "role": "non-text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.subtle}",
              "{color.surface.overlay}"
            ]
          }
        }
      },
      "input-invalid": {
        "$value": "{color.shadcn.dark-destructive}",
        "$description": "Border of an invalid field. Always paired with error text and an icon.",
        "$extensions": {
          "studio.graftwork": {
            "role": "non-text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.subtle}",
              "{color.surface.overlay}"
            ]
          }
        }
      },
      "default": {
        "$value": "{color.shadcn.dark-border}",
        "$description": "Dividers and card outlines. Not relied on to identify anything.",
        "$extensions": {
          "studio.graftwork": {
            "role": "decorative"
          }
        }
      },
      "status": {
        "success": {
          "$value": "{color.green.700}",
          "$extensions": {
            "studio.graftwork": {
              "role": "decorative"
            }
          }
        },
        "warning": {
          "$value": "{color.amber.700}",
          "$extensions": {
            "studio.graftwork": {
              "role": "decorative"
            }
          }
        },
        "error": {
          "$value": "{color.red.700}",
          "$extensions": {
            "studio.graftwork": {
              "role": "decorative"
            }
          }
        },
        "info": {
          "$value": "{color.shadcn.dark-border}",
          "$extensions": {
            "studio.graftwork": {
              "role": "decorative"
            }
          }
        }
      }
    },
    "icon": {
      "$type": "color",
      "$description": "Dark theme. icon tokens.",
      "default": {
        "$value": "{color.shadcn.dark-muted-foreground}",
        "$extensions": {
          "studio.graftwork": {
            "role": "non-text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.subtle}",
              "{color.surface.overlay}"
            ]
          }
        }
      },
      "brand": {
        "$value": "{color.shadcn.dark-primary}",
        "$description": "Selected marks and spinners. Neutral, matching the primary colour.",
        "$extensions": {
          "studio.graftwork": {
            "role": "non-text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.subtle}",
              "{color.surface.overlay}"
            ]
          }
        }
      }
    },
    "focus": {
      "$type": "color",
      "$description": "Dark theme. focus tokens.",
      "ring": {
        "$value": "{color.shadcn.dark-ring}",
        "$description": "Focus ring: 2px wide with a 2px offset, so a gap of surface always separates it from the component. Checked at 3:1 against every surface, which is what WCAG 2.4.13 measures.",
        "$extensions": {
          "studio.graftwork": {
            "role": "non-text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.subtle}",
              "{color.surface.overlay}"
            ]
          }
        }
      }
    },
    "chart": {
      "$type": "color",
      "$description": "Dark theme. chart tokens.",
      "series-1": {
        "$value": "{color.shadcn.dark-chart-1}",
        "$extensions": {
          "studio.graftwork": {
            "role": "non-text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}"
            ]
          }
        }
      },
      "series-2": {
        "$value": "{color.shadcn.dark-chart-2}",
        "$extensions": {
          "studio.graftwork": {
            "role": "non-text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}"
            ]
          }
        }
      },
      "series-3": {
        "$value": "{color.shadcn.dark-chart-3-aa}",
        "$extensions": {
          "studio.graftwork": {
            "role": "non-text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}"
            ]
          }
        }
      },
      "series-4": {
        "$value": "{color.shadcn.dark-chart-4-aa}",
        "$extensions": {
          "studio.graftwork": {
            "role": "non-text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}"
            ]
          }
        }
      },
      "grid": {
        "$value": "{color.shadcn.dark-border}",
        "$extensions": {
          "studio.graftwork": {
            "role": "decorative"
          }
        }
      }
    }
  }
}
