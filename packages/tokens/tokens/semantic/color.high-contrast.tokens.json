{
  "color": {
    "surface": {
      "$type": "color",
      "$description": "High-contrast theme (light base). surface tokens.",
      "default": {
        "$value": "{color.neutral.0}",
        "$description": "Page background.",
        "$extensions": {
          "studio.graftwork": {
            "role": "background"
          }
        }
      },
      "raised": {
        "$value": "{color.neutral.0}",
        "$description": "Cards and panels.",
        "$extensions": {
          "studio.graftwork": {
            "role": "background"
          }
        }
      },
      "subtle": {
        "$value": "{color.neutral.50}",
        "$description": "Table headers, wells, zebra rows.",
        "$extensions": {
          "studio.graftwork": {
            "role": "background"
          }
        }
      },
      "overlay": {
        "$value": "{color.neutral.0}",
        "$description": "Popovers, menus and dialogs.",
        "$extensions": {
          "studio.graftwork": {
            "role": "background"
          }
        }
      }
    },
    "overlay": {
      "$type": "color",
      "$description": "High-contrast theme. overlay tokens.",
      "scrim": {
        "$value": "{color.neutral.950}",
        "$description": "Behind modal dialogs and sheets. Use at reduced opacity, e.g. bg-overlay-scrim/60. Never text or a surface.",
        "$extensions": {
          "studio.graftwork": {
            "role": "decorative"
          }
        }
      }
    },
    "action": {
      "$type": "color",
      "$description": "High-contrast theme (light base). action tokens.",
      "primary": {
        "bg": {
          "$value": "{color.brand.900}",
          "$description": "Filled primary button.",
          "$extensions": {
            "studio.graftwork": {
              "role": "background"
            }
          }
        },
        "bg-hover": {
          "$value": "{color.brand.950}",
          "$extensions": {
            "studio.graftwork": {
              "role": "background"
            }
          }
        }
      },
      "secondary": {
        "bg": {
          "$value": "{color.neutral.0}",
          "$description": "Secondary button.",
          "$extensions": {
            "studio.graftwork": {
              "role": "background"
            }
          }
        },
        "bg-hover": {
          "$value": "{color.neutral.100}",
          "$extensions": {
            "studio.graftwork": {
              "role": "background"
            }
          }
        }
      },
      "ghost": {
        "bg-hover": {
          "$value": "{color.neutral.100}",
          "$description": "Ghost button hover.",
          "$extensions": {
            "studio.graftwork": {
              "role": "background"
            }
          }
        }
      },
      "destructive": {
        "bg": {
          "$value": "{color.red.800}",
          "$description": "Filled destructive button.",
          "$extensions": {
            "studio.graftwork": {
              "role": "background"
            }
          }
        },
        "bg-hover": {
          "$value": "{color.red.900}",
          "$extensions": {
            "studio.graftwork": {
              "role": "background"
            }
          }
        }
      }
    },
    "status": {
      "$type": "color",
      "$description": "High-contrast theme (light base). status tokens.",
      "success": {
        "bg": {
          "$value": "{color.green.50}",
          "$extensions": {
            "studio.graftwork": {
              "role": "background"
            }
          }
        }
      },
      "warning": {
        "bg": {
          "$value": "{color.amber.50}",
          "$extensions": {
            "studio.graftwork": {
              "role": "background"
            }
          }
        }
      },
      "error": {
        "bg": {
          "$value": "{color.red.50}",
          "$extensions": {
            "studio.graftwork": {
              "role": "background"
            }
          }
        }
      },
      "info": {
        "bg": {
          "$value": "{color.brand.50}",
          "$extensions": {
            "studio.graftwork": {
              "role": "background"
            }
          }
        }
      }
    },
    "text": {
      "$type": "color",
      "$description": "High-contrast theme (light base). text tokens.",
      "default": {
        "$value": "{color.neutral.1000}",
        "$description": "Body and heading text.",
        "$extensions": {
          "studio.graftwork": {
            "role": "text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.subtle}",
              "{color.surface.overlay}",
              "{color.action.secondary.bg}",
              "{color.action.secondary.bg-hover}",
              "{color.action.ghost.bg-hover}",
              "{color.status.success.bg}",
              "{color.status.warning.bg}",
              "{color.status.error.bg}",
              "{color.status.info.bg}"
            ]
          }
        }
      },
      "secondary": {
        "$value": "{color.neutral.800}",
        "$description": "Supporting text. At least 4.5:1 on its surfaces.",
        "$extensions": {
          "studio.graftwork": {
            "role": "text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.subtle}",
              "{color.surface.overlay}"
            ]
          }
        }
      },
      "placeholder": {
        "$value": "{color.neutral.800}",
        "$description": "Input placeholders. At least 4.5:1; never the only label.",
        "$extensions": {
          "studio.graftwork": {
            "role": "text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.overlay}"
            ]
          }
        }
      },
      "link": {
        "$value": "{color.brand.900}",
        "$description": "Links. Always underlined as well.",
        "$extensions": {
          "studio.graftwork": {
            "role": "text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.subtle}",
              "{color.surface.overlay}"
            ]
          }
        }
      },
      "on-primary": {
        "$value": "{color.neutral.0}",
        "$description": "Labels on filled primary buttons.",
        "$extensions": {
          "studio.graftwork": {
            "role": "text",
            "on": [
              "{color.action.primary.bg}",
              "{color.action.primary.bg-hover}"
            ]
          }
        }
      },
      "on-destructive": {
        "$value": "{color.neutral.0}",
        "$description": "Labels on filled destructive buttons.",
        "$extensions": {
          "studio.graftwork": {
            "role": "text",
            "on": [
              "{color.action.destructive.bg}",
              "{color.action.destructive.bg-hover}"
            ]
          }
        }
      },
      "success": {
        "$value": "{color.green.900}",
        "$extensions": {
          "studio.graftwork": {
            "role": "text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.subtle}",
              "{color.status.success.bg}"
            ]
          }
        }
      },
      "warning": {
        "$value": "{color.amber.900}",
        "$extensions": {
          "studio.graftwork": {
            "role": "text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.subtle}",
              "{color.status.warning.bg}"
            ]
          }
        }
      },
      "error": {
        "$value": "{color.red.900}",
        "$description": "Error messages, linked to their field.",
        "$extensions": {
          "studio.graftwork": {
            "role": "text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.subtle}",
              "{color.status.error.bg}"
            ]
          }
        }
      },
      "info": {
        "$value": "{color.brand.900}",
        "$extensions": {
          "studio.graftwork": {
            "role": "text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.subtle}",
              "{color.status.info.bg}"
            ]
          }
        }
      }
    },
    "border": {
      "$type": "color",
      "$description": "High-contrast theme (light base). border tokens.",
      "input": {
        "$value": "{color.neutral.950}",
        "$description": "Input, select and checkbox borders.",
        "$extensions": {
          "studio.graftwork": {
            "role": "non-text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.subtle}",
              "{color.surface.overlay}"
            ]
          }
        }
      },
      "input-invalid": {
        "$value": "{color.red.900}",
        "$description": "Border of an invalid field. Always paired with error text and an icon.",
        "$extensions": {
          "studio.graftwork": {
            "role": "non-text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.subtle}",
              "{color.surface.overlay}"
            ]
          }
        }
      },
      "default": {
        "$value": "{color.neutral.700}",
        "$description": "Dividers and card outlines. Not relied on to identify anything.",
        "$extensions": {
          "studio.graftwork": {
            "role": "decorative"
          }
        }
      },
      "status": {
        "success": {
          "$value": "{color.green.800}",
          "$extensions": {
            "studio.graftwork": {
              "role": "decorative"
            }
          }
        },
        "warning": {
          "$value": "{color.amber.800}",
          "$extensions": {
            "studio.graftwork": {
              "role": "decorative"
            }
          }
        },
        "error": {
          "$value": "{color.red.800}",
          "$extensions": {
            "studio.graftwork": {
              "role": "decorative"
            }
          }
        },
        "info": {
          "$value": "{color.neutral.800}",
          "$extensions": {
            "studio.graftwork": {
              "role": "decorative"
            }
          }
        }
      }
    },
    "icon": {
      "$type": "color",
      "$description": "High-contrast theme (light base). icon tokens.",
      "default": {
        "$value": "{color.neutral.900}",
        "$extensions": {
          "studio.graftwork": {
            "role": "non-text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.subtle}",
              "{color.surface.overlay}"
            ]
          }
        }
      },
      "brand": {
        "$value": "{color.brand.700}",
        "$description": "The brand colour. Icons, borders and decoration; never text.",
        "$extensions": {
          "studio.graftwork": {
            "role": "non-text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.subtle}",
              "{color.surface.overlay}"
            ]
          }
        }
      }
    },
    "focus": {
      "$type": "color",
      "$description": "High-contrast theme (light base). focus tokens.",
      "ring": {
        "$value": "{color.neutral.1000}",
        "$description": "Focus ring: 2px wide with a 2px offset, so a gap of surface always separates it from the component. Checked at 3:1 against every surface, which is what WCAG 2.4.13 measures.",
        "$extensions": {
          "studio.graftwork": {
            "role": "non-text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}",
              "{color.surface.subtle}",
              "{color.surface.overlay}"
            ]
          }
        }
      }
    },
    "chart": {
      "$type": "color",
      "$description": "High-contrast theme (light base). chart tokens.",
      "series-1": {
        "$value": "{color.brand.700}",
        "$extensions": {
          "studio.graftwork": {
            "role": "non-text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}"
            ]
          }
        }
      },
      "series-2": {
        "$value": "{color.amber.700}",
        "$extensions": {
          "studio.graftwork": {
            "role": "non-text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}"
            ]
          }
        }
      },
      "series-3": {
        "$value": "{color.neutral.800}",
        "$extensions": {
          "studio.graftwork": {
            "role": "non-text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}"
            ]
          }
        }
      },
      "series-4": {
        "$value": "{color.green.800}",
        "$extensions": {
          "studio.graftwork": {
            "role": "non-text",
            "on": [
              "{color.surface.default}",
              "{color.surface.raised}"
            ]
          }
        }
      },
      "grid": {
        "$value": "{color.neutral.300}",
        "$extensions": {
          "studio.graftwork": {
            "role": "decorative"
          }
        }
      }
    }
  }
}
