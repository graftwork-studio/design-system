{
  "name": "@graftwork/tokens",
  "version": "2.0.0",
  "description": "Graftwork design tokens: CSS variables, a Tailwind v4 theme and JS constants",
  "license": "MIT",
  "homepage": "https://graftwork-studio.github.io/design-system/",
  "bugs": {
    "url": "https://github.com/graftwork-studio/design-system/issues"
  },
  "keywords": [
    "design-tokens",
    "dtcg",
    "tailwindcss",
    "accessibility"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graftwork-studio/design-system.git",
    "directory": "packages/tokens"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "dist",
    "tokens"
  ],
  "exports": {
    ".": {
      "types": "./dist/js/tokens.d.ts",
      "default": "./dist/js/tokens.js"
    },
    "./css": "./dist/css/tokens.css",
    "./tailwind.css": "./dist/css/tailwind-theme.css",
    "./tokens/*": "./tokens/*"
  },
  "scripts": {
    "palette": "node scripts/generate-palette.ts",
    "build": "node scripts/build.ts",
    "validate": "node scripts/validate-contrast.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/culori": "4.0.1",
    "@types/node": "26.6.6",
    "culori": "4.0.2",
    "style-dictionary": "5.8.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
