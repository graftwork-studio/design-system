{
  "name": "@graftwork/ui",
  "version": "2.9.0",
  "description": "Graftwork React components, built on shadcn/ui with React Aria",
  "license": "MIT",
  "homepage": "https://graftwork-studio.github.io/design-system/",
  "bugs": {
    "url": "https://github.com/graftwork-studio/design-system/issues"
  },
  "keywords": [
    "react",
    "react-aria",
    "shadcn",
    "tailwindcss",
    "accessibility",
    "design-system"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graftwork-studio/design-system.git",
    "directory": "packages/ui"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./showcase": {
      "types": "./dist/showcase/component-showcase.d.ts",
      "default": "./dist/showcase/component-showcase.js"
    },
    "./styles.css": {
      "style": "./dist/styles.css",
      "default": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@graftwork/tokens": "workspace:^",
    "@internationalized/date": "3.12.4",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.74.0",
    "react-aria-components": "1.22.1",
    "react-is": "19.3.1",
    "react-resizable-panels": "4.24.1",
    "recharts": "3.11.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.1.1",
    "playwright": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "vitest-browser-react": "2.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
